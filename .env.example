# That Waffle Place - Environment Configuration Template
# Copy this file to .env and fill in your production values.

# Server Port (default 8080)
PORT=8080

# Meta WhatsApp Cloud API Production Credentials
# Generate a Permanent System User Token in Meta Business Suite (Never Expire)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DELIVERY_MODE=twp_offer_broadcast
WHATSAPP_VERIFY_TOKEN=that_waffle_place_webhook_secret_2026

# Supabase (Optional - Local proxy handles customers, broadcasts & logs automatically)
SUPABASE_URL=https://hdewnmlpuznncvkyxpjn.supabase.co
SUPABASE_KEY=sb_publishable_5X5KVusc1uaVCdilCc7MQA_xOl_Xyna
# Privileged service role key for server-side PostgreSQL upserting (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Windows Excel Live Sync Subsystem
# Comma-separated list of authorized device keys for client sync agents
SYNC_DEVICE_KEYS=twp_sync_device_secret_key_2026
